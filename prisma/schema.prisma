// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ==========================================
// BACKEND TEAM MANAGEMENT & RBAC MODELS
// ==========================================

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  passwordHash String?     // Null nếu dùng OAuth SSO
  avatarUrl    String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Ví dụ: "Super Admin", "Designer", "CSKH"
  code        String           @unique // Ví dụ: "super_admin", "designer"
  description String?
  isSystem    Boolean          @default(false) // Role hệ thống không thể xóa
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String   // system, personalization, reviews, upsell
  resource    String   // users, templates, items, campaigns
  action      String   // read, create, update, delete, moderate...
  code        String   @unique // Ví dụ: "personalization:templates:create"
  name        String   // Tên hiển thị tiếng Việt
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // VD: "CREATE_USER", "UPDATE_TEMPLATE", "APPROVE_REVIEW"
  resource  String   // VD: "user:123", "template:456"
  payload   String?  // JSON stringified chi tiết thao tác
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ==========================================
// PERSONALIZATION & ARTWORK MODELS
// ==========================================

model Artwork {
  id              String   @id @default(uuid())
  title           String
  category        String   @default("Best Friends")
  niche           String   @default("Quotes")
  imageUrl        String
  dimensions      String   @default("1000x1000")
  layerCount      Int      @default(1)
  optionCount     Int      @default(1)
  createdBy       String   @default("Admin")
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("artworks")
}

// ==========================================
// MEDIA & FILES MANAGEMENT MODELS
// ==========================================

model MediaFile {
  id              String   @id @default(uuid())
  fileName        String
  fileSize        Int      // Bytes
  fileType        String   // VD: "image/png", "font/ttf", "application/pdf"
  category        String   @default("IMAGE") // "IMAGE", "FONT", "DOCUMENT", "VECTOR"
  url             String   
  thumbnailUrl    String?  // Link ảnh thu nhỏ tối ưu (WebP, width 400px)
  key             String   @unique
  thumbnailKey    String?  // Key R2 của ảnh thu nhỏ
  dimensions      String?  // VD: "1200x800"
  altText         String?
  folder          String   @default("general")
  uploadedBy      String   @default("Admin")
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("media_files")
}

model MediaFolder {
  id              String   @id @default(uuid())
  name            String   @unique // Slug của folder: VD "artworks", "cliparts"
  label           String   // Tên hiển thị: VD "Artworks", "Cliparts"
  createdBy       String?  @default("Admin")
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("media_folders")
}
