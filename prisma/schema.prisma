// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// ==========================================
// USER & ROLE-BASED ACCESS CONTROL (RBAC)
// ==========================================

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userRoles     UserRole[]

  @@map("users")
}

model Role {
  id          String         @id @default(uuid())
  code        String         @unique // VD: "SUPER_ADMIN", "ADMIN", "EDITOR", "VIEWER"
  name        String         // VD: "Super Admin", "Admin", "Editor", "Viewer"
  description String?
  isSystem    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String         @id @default(uuid())
  code        String         @unique // VD: "artworks:create", "artworks:edit", "artworks:delete", "users:manage"
  name        String
  category    String         @default("General") // VD: "Artworks", "Users", "Settings"
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// ARTWORK & PERSONALIZATION ENGINE
// ==========================================

model Artwork {
  id              String   @id @default(uuid())
  title           String
  sku             String?  @unique
  category        String   @default("Best Friends")
  niche           String   @default("Quotes")
  thumbnailUrl    String?
  previewUrl      String?
  status          String   @default("DRAFT") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  widthPx         Int      @default(1000)
  heightPx        Int      @default(1000)
  fieldCount      Int      @default(0)
  optionCount     Int      @default(1)
  createdBy       String   @default("Admin")
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("artworks")
}

// ==========================================
// VISUAL ARTWORK STUDIO MODELS (RELATIONAL 3NF SCHEMATIC)
// ==========================================

model StudioArtwork {
  id                  String   @id @default(uuid())
  title               String
  category            String   @default("Best Friends")
  niche               String   @default("Quotes")
  widthPx             Int      @default(1000)
  heightPx            Int      @default(1000)
  bgUrl               String?
  thumbnailUrl        String?

  // STOREFRONT MAIN CUSTOMIZATION FIELD CONFIG FOR SCREENS
  enableScreenField   Boolean  @default(false)
  screenCustomerLabel String?  @default("Number Of Grandkids")
  screenDisplayMode   String?  @default("BUTTON") // "BUTTON" | "DROPDOWN" | "ICON" | "THUMBNAIL"
  
  // JSON BACKUPS FOR COMPATIBILITY AND PERFORMANCE SNAPSHOTS
  screens             String?  // JSON String storing screens array
  screenFieldConfig   String?  // JSON String storing screenFieldConfig

  createdByName       String?  @default("Super Admin")
  createdByAvatar     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  studioScreens       StudioScreen[]
  layers              StudioLayer[]
  fields              StudioField[]
  rules               StudioConditionRule[]

  @@map("studio_artworks")
}

model StudioScreen {
  id                  String        @id @default(uuid())
  artworkId           String
  artwork             StudioArtwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  name                String        // VD: "1 Grandkid", "4 Grandkids"
  bgUrl               String?       // Cloudflare R2 Background Image URL
  bgColor             String?       @default("#ffffff")
  iconUrl             String?       // Swatch Icon Image URL
  sortOrder           Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  layers              StudioLayer[]
  fields              StudioField[]

  @@map("studio_screens")
}

model StudioLayer {
  id              String        @id @default(uuid())
  artworkId       String
  artwork         StudioArtwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  screenId        String?
  screen          StudioScreen? @relation(fields: [screenId], references: [id], onDelete: Cascade)
  name            String
  layerType       String        // "BACKGROUND" | "ASSET" | "TEXT" | "PHOTO_UPLOAD" | "OVERLAY"
  zIndex          Int           @default(0)
  posX            Float         @default(0)
  posY            Float         @default(0)
  width           Float         @default(200)
  height          Float         @default(200)
  rotation        Float         @default(0)
  scaleX          Float         @default(1)
  scaleY          Float         @default(1)
  isVisible       Boolean       @default(true)
  isLocked        Boolean       @default(false)
  properties      String?       // JSON String: font, color, text, assetUrl, alignment...
  linkedFieldId   String?       // Gắn Layer với Field tùy chỉnh

  @@map("studio_layers")
}

model StudioField {
  id            String        @id @default(uuid())
  artworkId     String
  artwork       StudioArtwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  screenId      String?
  screen        StudioScreen? @relation(fields: [screenId], references: [id], onDelete: Cascade)
  label         String        // VD: "Select Hair Style", "Enter Name"
  fieldType     String        // "TEXT" | "CALENDAR" | "RADIO" | "SELECT" | "IMAGE_UPLOAD" | "FIELD_ASSET"
  sortOrder     Int           @default(0)
  isRequired    Boolean       @default(false)
  config        String?       // JSON String: options list, max length, font list, asset categories...

  @@map("studio_fields")
}

model StudioConditionRule {
  id             String        @id @default(uuid())
  artworkId      String
  artwork        StudioArtwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  sourceFieldId  String        // Field điều kiện (VD: Radio "Gender")
  operator       String        @default("EQUALS") // "EQUALS" | "NOT_EQUALS"
  targetValue    String        // VD: "Female"
  action         String        // "SHOW_LAYER" | "HIDE_LAYER" | "SHOW_FIELD" | "HIDE_FIELD"
  targetId       String        // Layer ID hoặc Field ID tác động

  @@map("studio_condition_rules")
}

// ==========================================
// MEDIA & FILES MANAGEMENT MODELS
// ==========================================

model MediaFile {
  id              String   @id @default(uuid())
  fileName        String
  fileSize        Int      // Bytes
  fileType        String   // VD: "image/png", "font/ttf", "application/pdf"
  category        String   @default("IMAGE") // "IMAGE", "FONT", "DOCUMENT", "VECTOR"
  url             String   
  thumbnailUrl    String?  // Link ảnh thu nhỏ tối ưu (WebP, width 400px)
  key             String   @unique
  thumbnailKey    String?  // Key R2 của ảnh thu nhỏ
  dimensions      String?  // VD: "1200x800"
  altText         String?
  folder          String   @default("general")
  uploadedBy      String   @default("Admin")
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("media_files")
}

model MediaFolder {
  id              String   @id @default(uuid())
  name            String   @unique // Slug của folder: VD "artworks", "cliparts"
  label           String   // Tên hiển thị: VD "Artworks", "Cliparts"
  createdBy       String?  @default("Admin")
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("media_folders")
}

// ==========================================
// FONT MANAGEMENT MODELS
// ==========================================

model Font {
  id              String   @id @default(uuid())
  name            String   // VD: "Dancing Script", "Montserrat", "Custom Handwriting"
  family          String   // CSS Font Family name: VD "Dancing Script"
  fontType        String   @default("GOOGLE") // "GOOGLE" | "CUSTOM"
  sourceUrl       String?  // Google font family / CSS URL OR uploaded font file URL (.ttf, .otf, .woff, .woff2)
  fileKey         String?  // Storage key if uploaded custom font file
  variants        String?  // JSON string e.g. ["400", "700"]
  isDefault       Boolean  @default(false)
  createdByName   String?  @default("Super Admin")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("fonts")
}

// ==========================================
// DOODLE ALPHABET PACK MANAGEMENT MODELS
// ==========================================

model DoodlePack {
  id              String        @id @default(uuid())
  name            String        // VD: "Christmas Candy Cane Alphabet"
  code            String        @unique // VD: "christmas_candy_cane_alphabet"
  description     String?
  thumbnailUrl    String?
  isActive        Boolean       @default(true)
  createdByName   String?       @default("Super Admin")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  styles          DoodleStyle[]

  @@map("doodle_packs")
}

model DoodleStyle {
  id              String         @id @default(uuid())
  packId          String
  pack            DoodlePack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  name            String         // VD: "Candy Stripe", "Leopard Print"
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  letters         DoodleLetter[]

  @@map("doodle_styles")
}

model DoodleLetter {
  id              String       @id @default(uuid())
  styleId         String
  style           DoodleStyle  @relation(fields: [styleId], references: [id], onDelete: Cascade)
  char            String       // VD: "A", "B", "1", "9"
  imageUrl        String       // Cloudflare R2 or local asset URL
  width           Int?
  height          Int?

  @@unique([styleId, char])
  @@map("doodle_letters")
}

// ==========================================
// CLIP ART LIBRARY (LAYER-BASED COMPOSITE OBJECTS)
// ==========================================
// A ClipArt is a small, layer-based composition (like an artwork screen, but
// with no customer fields/screens/rules). Its layers are stored as a JSON
// snapshot and flattened into a single reusable object (compositeUrl) that
// artwork Field Asset options can pull in as one object.

model ClipArt {
  id              String   @id @default(uuid())
  name            String
  category        String   @default("General")
  tags            String?  // Comma separated search tags
  widthPx         Int      @default(1000)
  heightPx        Int      @default(1000)
  bgColor         String?  // Optional solid background (usually transparent)
  layers          String?  // JSON string: CanvasLayerItem[] source layers (editable)
  compositeUrl    String?  // Flattened PNG of the whole object (used by artwork)
  compositeKey    String?  // Storage key of the composite (overwritten on re-export)
  thumbnailUrl    String?  // Square thumbnail for the library grid
  layerCount      Int      @default(0)
  status          String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  createdByName   String?  @default("Super Admin")
  createdByAvatar String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("clip_arts")
}
